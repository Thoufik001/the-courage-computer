GEMINI_API_KEY=
# Verified against https://ai.google.dev/gemini-api/docs/models on 2026-10-08
GEMINI_MODEL=gemini-3.5-flash-lite
# Set only behind a reverse proxy that replaces x-forwarded-for:
TRUST_PROXY=false

# Private /activity dashboard; generate a random scrypt salt/hash as salt:hex-digest.
ACTIVITY_PASSWORD_HASH=
ACTIVITY_SESSION_SECRET=
# Neon Postgres connection string; server-only, never NEXT_PUBLIC_.
DATABASE_URL=
